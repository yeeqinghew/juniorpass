# API runtime
# Set to development, staging, or production.
NODE_ENV=
# HTTP port; hosting platforms commonly provide this automatically.
PORT=

# Database
# Prefer DATABASE_URL for hosted PostgreSQL. Use the POSTGRES_* fields for a local connection instead.
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DATABASE=

# Authentication and browser access
# Long, randomly generated server-side signing secret.
JWT_SECRET=
# Comma-separated trusted browser origins allowed to call this API.
ALLOWED_ORIGINS=
# Public URL of the main client, used in emails and redirects.
FRONTEND_URL=
# Optional legacy alias for FRONTEND_URL.
CLIENT_URL=
# Override cookie transport settings only when required by the hosting setup.
AUTH_COOKIE_SECURE=
AUTH_COOKIE_SAME_SITE=

# Google sign-in
GOOGLE_CLIENT_ID=

# Email delivery
RESEND_API_KEY=

# Media storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cache and session revocation
REDIS_URL=

# HitPay payments
HITPAY_SANDBOX_API_KEY=
HITPAY_SANDBOX_SECRET_KEY=
# Explicit webhook endpoint; otherwise the environment-specific URL settings are used.
WEBHOOK_URL=
PRODUCTION_URL=
STAGING_URL=
NGROK_URL=

# Background reminders
# Set true to enable outside production, or false to disable in production.
CLASS_REMINDERS_ENABLED=
