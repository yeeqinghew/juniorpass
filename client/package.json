{
  "name": "jp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "check:no-js": "node -e \"const fs=require('node:fs'),path=require('node:path'),bad=[],skip=new Set(['node_modules','dist','build','.git','.vercel']),allowed=new Set(['eslint.config.js','test/packageTypes.test.js']);const walk=d=>{for(const e of fs.readdirSync(d,{withFileTypes:true})){const p=path.join(d,e.name),n=p.replaceAll('\\\\','/').replace(/^\\.\\//,'');if(e.isDirectory()){if(!skip.has(e.name))walk(p)}else if(/\\.(?:js|jsx)$/.test(e.name)&&!allowed.has(n))bad.push(n)}};walk('.');if(bad.length){console.error('New JavaScript files are not allowed in the client:\\n'+bad.join('\\n'));process.exit(1)}\"",
    "predev": "npm run check:no-js",
    "dev": "vite",
    "prebuild": "npm run check:no-js",
    "build": "vite build",
    "prelint": "npm run check:no-js",
    "lint": "eslint .",
    "pretypecheck": "npm run check:no-js",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run check:no-js",
    "test": "node --test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-oauth/google": "^0.12.1",
    "@splidejs/react-splide": "^0.7.12",
    "@splidejs/splide-extension-grid": "^0.4.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "antd": "^5.13.2",
    "aos": "^2.3.4",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.20",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.17.21",
    "mapbox-gl": "^1.13.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-geocode": "^1.0.0-alpha.1",
    "react-hot-toast": "^2.4.1",
    "react-idle-timer": "^5.7.2",
    "react-map-gl": "^7.1.7",
    "react-refresh": "^0.14.2",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/crypto-js": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.1"
  }
}
